<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(CelerityTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Native AOT smoke test (#32). PublishAot turns on the trim/AOT analyzers for
      the consumer side too and lets CI run `dotnet publish` to compile the whole
      library + every generic instantiation this app forces down to a native
      binary. If any Celerity code path were AOT-incompatible, the publish or the
      native binary's runtime assertions would fail. Not packaged or tested as a
      unit; it exists purely as a CI publish target.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Celerity\Celerity.csproj" />
    <ProjectReference Include="..\Celerity.Sorting\Celerity.Sorting.csproj" />
    <ProjectReference Include="..\Celerity.Statistics\Celerity.Statistics.csproj" />
    <!--
      The showcase-tier packages. They set IsAotCompatible like the rest of the
      family, so the analyzers already cover them, but without a reference here no
      native binary ever exercised their instantiations. Referencing them puts the
      types they close over Celerity.Collections into the publish.
    -->
    <ProjectReference Include="..\Celerity.Ring\Celerity.Ring.csproj" />
    <ProjectReference Include="..\Celerity.Sentinel\Celerity.Sentinel.csproj" />
    <ProjectReference Include="..\Celerity.Cardinality\Celerity.Cardinality.csproj" />
  </ItemGroup>

</Project>
