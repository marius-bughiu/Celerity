<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  Six entries, one deliberate break, two types: the bare-named UInt32Hasher and UInt64Hasher
  are gone (#297). Each is CP0001 — the type no longer exists — once per target framework.

  They shipped as [Obsolete] aliases from v2.6.0 through v3.0.0, forwarding to
  UInt32WangNaiveHasher and UInt64Murmur3Hasher respectively, and their own docs, the API
  reference and the migration guide all said they would go in a future major. Callers migrate
  by renaming: the replacements hash identically, and UInt64Murmur3Hasher carries the same
  IHashProvider64<ulong> implementation, so a sketch parameterized on it keeps its 64-bit path.

  Celerity.Collections drops the two matching [TypeForwardedTo] entries in the same change and
  is not listed here, because ApiCompat resolves a forwarder through the referenced assembly
  and reports the removal once, against Celerity.Hashing. The break is real for a consumer
  either way: an assembly that bound Celerity.UInt32Hasher through the forwarder no longer
  resolves it. See docs/migration.md.

  All of it can be deleted once CelerityPackageValidationBaseline moves past the release that
  carries the removal.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:Celerity.Hashing.UInt32Hasher</Target>
    <Left>lib/net10.0/Celerity.Hashing.dll</Left>
    <Right>lib/net10.0/Celerity.Hashing.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:Celerity.Hashing.UInt64Hasher</Target>
    <Left>lib/net10.0/Celerity.Hashing.dll</Left>
    <Right>lib/net10.0/Celerity.Hashing.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:Celerity.Hashing.UInt32Hasher</Target>
    <Left>lib/net8.0/Celerity.Hashing.dll</Left>
    <Right>lib/net8.0/Celerity.Hashing.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:Celerity.Hashing.UInt64Hasher</Target>
    <Left>lib/net8.0/Celerity.Hashing.dll</Left>
    <Right>lib/net8.0/Celerity.Hashing.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:Celerity.Hashing.UInt32Hasher</Target>
    <Left>lib/net9.0/Celerity.Hashing.dll</Left>
    <Right>lib/net9.0/Celerity.Hashing.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:Celerity.Hashing.UInt64Hasher</Target>
    <Left>lib/net9.0/Celerity.Hashing.dll</Left>
    <Right>lib/net9.0/Celerity.Hashing.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>